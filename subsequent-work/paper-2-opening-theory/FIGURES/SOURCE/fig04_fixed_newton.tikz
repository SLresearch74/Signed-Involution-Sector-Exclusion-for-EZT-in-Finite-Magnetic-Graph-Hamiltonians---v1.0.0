\begin{scope}[xshift=1cm]
\draw[->] (0,0)--(4.3,0) node[right] {$p$}; \draw[->] (0,0)--(0,4.3) node[above] {$q$};
\fill[orange!15] (2,4) rectangle (4,4.15); \draw[orange!80!black,thick] (2,4)--(4,4); \draw[orange!80!black,thick] (2,4)--(2,4.15);
